/build/
example/flutter_story_app/build/
coverage/
pubspec.lock
*.iml
.idea/
.vscode/

# Generated by `dart doc`.
doc/api/

# Private/internal development history. These remain available in the local
# combined workspace but must not be committed to the public story_engine repo.
doc/architecture/
doc/PUBLICATION_CHECKLIST.md
doc/fixtures/
lib/src/README.md
test/architecture/
test/architecture/stage6h_publication_readiness_test.dart

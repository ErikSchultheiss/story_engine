# Companion application / handoff artifacts are never part of this repository.
cyoa_studio/
CYOA-Development*/
*.zip

# Common local credentials/secrets.
.env
.env.*
*.jks
*.keystore
key.properties
local.properties
benchmark/stage6g_performance_baseline.dart

